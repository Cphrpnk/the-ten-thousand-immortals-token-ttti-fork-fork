type LiquidityMintError = 
 variant {
   aboveCap:
    record {
      capTtti: nat;
      remainingTtti: nat;
      requestedTtti: nat;
      returnedToContractTtti: nat;
      soldTtti: nat;
    };
   acknowledgementRequired;
   anonymousCaller;
   belowMinimum:
    record {
      granularityTtti: nat;
      minimumTtti: nat;
      requestedTtti: nat;
    };
   deadlineExpired: record {
                      deadline: Timestamp;
                      now: Timestamp;
                    };
   depositFailedRefundFailed: record {mintId: MintId;};
   depositFailedRefunded: record {mintId: MintId;};
   depositFailedRefunding: record {mintId: MintId;};
   dexPaused;
   firstDepositBelowMinimum: record {
                               minimumTtti: nat;
                               requestedTtti: nat;
                             };
   insufficientAllowance:
    record {
      allowance: nat;
      required: nat;
      token: PayToken;
    };
   insufficientBalance: record {
                          balance: nat;
                          required: nat;
                          token: PayToken;
                        };
   invalidAmount;
   invalidSlippage: record {maximumBps: nat;};
   invalidTargetPool: record {
                        poolId: PoolId;
                        reason: InvalidTargetReason;
                      };
   ledgerError: record {
                  message: text;
                  token: PayToken;
                };
   maxPayExceeded: record {
                     maxPayAmount: nat;
                     payAmount: nat;
                   };
   minimumsNotSet;
   mintEnded;
   poolNotFound: record {token: PayToken;};
   poolRemoved;
   poolUnavailable: record {message: text;};
   purchaseInProgress;
   rateSourcesDiverge:
    record {
      coinbaseUsdE8: opt nat;
      coingeckoUsdE8: opt nat;
      differenceBps: opt nat;
      maximumBps: nat;
      token: PayToken;
    };
   rateUnavailable: record {token: PayToken;};
   removalAnnounced: record {effectiveAt: Timestamp;};
   reserveConversionDeviation: record {
                                 deviationBps: nat;
                                 maximumBps: nat;
                               };
   reserveConversionFailed: record {message: text;};
   salesPaused;
   slippageExceeded: record {toleranceBps: nat;};
   tooManyDecimals:
    record {
      given: text;
      granularityTtti: nat;
      maxDecimals: nat;
      minimumTtti: nat;
    };
 };
