type BtcCostToRefund = 
 record {
   amount: nat;
   conversionId: opt nat;
   refundedBlock: opt nat;
 };
type BlockIndex = nat;
type Block = 
 record {
   block: Value__1;
   id: nat;
 };
type BalanceSnapshot = 
 record {
   decimals: nat8;
   exportedAt: Timestamp__2;
   holders: vec SnapshotEntry;
   totalSupply: nat;
 };
type AttemptOutcome = 
 variant {
   failed: text;
   pending;
   succeeded: nat;
   unknown;
 };
type ArchiveInfo = 
 record {
   canister_id: principal;
   end: nat;
   start: nat;
 };
type ApproveResult = 
 variant {
   Err: ApproveError;
   Ok: nat;
 };
type ApproveError = 
 variant {
   AllowanceChanged: record {current_allowance: nat;};
   BadFee: record {expected_fee: nat;};
   CreatedInFuture: record {ledger_time: Timestamp__2;};
   Duplicate: record {duplicate_of: nat;};
   Expired: record {ledger_time: Timestamp__2;};
   ExpiredFrom: record {ledger_time: Timestamp__2;};
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   InsufficientFunds: record {balance: nat;};
   TemporarilyUnavailable;
   TooOld;
 };
type ApproveArgs = 
 record {
   amount: nat;
   created_at_time: opt Timestamp__2;
   expected_allowance: opt nat;
   expires_at: opt Timestamp__2;
   fee: opt nat;
   from_subaccount: opt Subaccount;
   memo: opt blob;
   spender: Account;
 };
type AllowanceArgs = 
 record {
   account: Account;
   spender: Account;
 };
type Allowance = 
 record {
   allowance: nat;
   expires_at: opt Timestamp__2;
 };
type AddressBookError = 
 variant {
   anonymous;
   duplicateNickname;
   invalidInput: InvalidReason;
   limitReached: record {max: nat;};
   notFound;
 };
type AcknowledgementError = variant {anonymousCaller;};
type AcknowledgedAt = int;
type Account = 
 record {
   owner: principal;
   subaccount: opt Subaccount;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result_8);
  _internet_identity_sign_in_start: () -> (blob);
  acceptPurchaseAcknowledgements: () ->
   (variant {
      err: AcknowledgementError;
      ok: PurchaseAcknowledgement;
    });
  addContact: (input: ContactInput) -> (Result);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  cancelBuyback: (id: BuybackId) -> (Result_1);
  checkBtcPurchaseDeposit: () -> (BtcDepositResult);
  checkBtcWalletDeposit: () -> (BtcDepositResult);
  checkBtcWalletDepositFor: (owner: principal) -> (BtcDepositResult);
  clearDeliveryAddress: () -> (bool);
  convertDeposit: (recipient: opt Account, icpAmount: nat) ->
   (PurchaseResult);
  convertDepositWith: (token: PayToken, recipient: opt Account, payAmount:
   nat, tttiTarget: opt nat) -> (PurchaseResult);
  deleteContact: (id: ContactId) -> (Result_7);
  execute: (qJson: text) -> (Result__1) query;
  exportBalanceSnapshot: () -> (BalanceSnapshot) query;
  getApiDoc: () -> (text) query;
  getBtcDepositInfo: () -> (BtcDepositInfo) query;
  getBtcPurchaseAddress: () -> (BtcDepositResult);
  getBtcUsdRate: () -> (opt BtcUsdRate) query;
  getBtcWalletAddress: () -> (BtcDepositResult);
  getBtcWalletAddressFor: (owner: principal) -> (BtcDepositResult);
  getBtcWalletDepositsFor: (owner: principal) -> (opt DepositTracking) query;
  getBurnAccount: () -> (Account) query;
  getBuybackAdminAccount: () -> (opt Account) query;
  getBuybackFunding: () -> (vec BuybackFunding);
  getCallerUserRole: () -> (UserRole) query;
  getCanisterPrincipal: () -> (principal) query;
  getConversions: () -> (vec Conversion) query;
  getCyclesStatus: () -> (CyclesStatus) query;
  getDeliveryAddress: () -> (opt Account) query;
  getFeeCollector: () -> (FeeCollectorInfo) query;
  getIcpPrice: () -> (IcpPrice) query;
  getLegacyBlockInfo: () -> (LegacyBlockInfo) query;
  getMyBtcDeposits: () -> (MyBtcDeposits) query;
  getMyConversions: () -> (vec Conversion) query;
  getMyPurchaseAcknowledgement: () -> (PurchaseAcknowledgement) query;
  getPublicTreasuryInfo: () -> (opt PublicTreasuryInfo) query;
  getSaleStatus: () -> (SaleStatus) query;
  getTechnicalDetails: () -> (TechnicalDetails) query;
  getTokenPrices: () -> (vec TokenPrice) query;
  getTreasuryConfig: () -> (opt TreasuryConfig) query;
  getUpgradeReadiness: () -> (UpgradeReadiness) query;
  get_account_transactions: (args: GetAccountTransactionsArgs) ->
   (GetTransactionsResult) query;
  get_fee: () -> (nat) query;
  get_fee_bounds: () -> (FeeBounds) query;
  get_max_supply: () -> (nat) query;
  icrc10_supported_standards: () -> (vec SupportedStandard) query;
  icrc1_balance_of: (account: Account) -> (nat) query;
  icrc1_decimals: () -> (nat8) query;
  icrc1_fee: () -> (nat) query;
  icrc1_metadata: () -> (vec record {
                               text;
                               MetadataValue;
                             }) query;
  icrc1_minting_account: () -> (opt Account) query;
  icrc1_name: () -> (text) query;
  icrc1_supported_standards: () -> (vec SupportedStandard) query;
  icrc1_symbol: () -> (text) query;
  icrc1_total_supply: () -> (nat) query;
  icrc1_transfer: (args: TransferArgs) -> (TransferResult);
  icrc2_allowance: (args: AllowanceArgs) -> (Allowance) query;
  icrc2_approve: (args: ApproveArgs) -> (ApproveResult);
  icrc2_transfer_from: (args: TransferFromArgs) -> (TransferFromResult);
  icrc3_get_archives: (args: GetArchivesArgs) -> (vec ArchiveInfo) query;
  icrc3_get_blocks: (args: vec GetBlocksArgs) -> (GetBlocksResult) query;
  icrc3_get_tip_certificate: () -> (opt DataCertificate) query;
  icrc3_supported_block_types: () -> (vec SupportedBlockType) query;
  isCallerAdmin: () -> (bool) query;
  ledger_id: () -> (principal) query;
  listAllBuybackMasses: () -> (vec BuybackMass) query;
  listAllBuybacks: () -> (vec Buyback) query;
  listMyBuybackMasses: () -> (Result_6) query;
  listMyBuybacks: () -> (Result_5) query;
  listMyContacts: () -> (Result_4) query;
  listTransfersToReview: () -> (vec TransferReview) query;
  list_subaccounts: (args: ListSubaccountsArgs) -> (vec Subaccount) query;
  markBuybackCancelled: (id: BuybackId, block: nat) -> (Result_1);
  markRefundedManually: (kind: TransferKind, purchaseId: nat, block: 
   nat) -> (ReviewResult);
  markTransferArrived: (kind: TransferKind, purchaseId: nat, block: nat) ->
   (ReviewResult);
  markTransferNotArrived: (kind: TransferKind, purchaseId: nat) ->
   (ReviewResult);
  quoteBuyback: (massToken: PayToken, percent: nat, receiveToken:
   PayToken) -> (Result_3) query;
  reconcileReserved: () -> (Result_2);
  refreshIcpPrice: () -> (PriceResult);
  refreshTokenPrice: (token: PayToken) -> (TokenPriceResult);
  requestBuyback: (massToken: PayToken, percent: nat, receiveToken: PayToken,
   fromSubaccount: opt blob) -> (Result_1);
  retryBuybackPayout: (buybackId: BuybackId) -> (Result_1);
  schema: () -> (text) query;
  setBuybackAdminAccount: (account: Account) -> ();
  setDeliveryAddress: (principalText: text) -> (DeliveryAddressResult);
  setPayTokenAccount: (token: PayToken, account: Account) ->
   (TokenAccountResult);
  setSalesPaused: (paused: bool) -> ();
  setTreasuryConfig: (config: TreasuryConfig) -> (TreasuryConfigResult);
  set_fee: (newFee: nat) -> (SetFeeResult);
  status: () -> (IndexStatus) query;
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  updateContact: (id: ContactId, input: ContactInput) -> (Result);
  withdrawReserveExcess: (amount: nat) -> (WithdrawReserveResult);
}
