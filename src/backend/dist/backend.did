  adminGetRouterFees: () ->
   (variant {
      err: RouterAdminError;
      ok: vec RouterFeeView;
    }) query;
  adminListRoutedSwaps: (cursor: opt nat, limit: nat) ->
   (variant {
      err: RouterAdminError;
      ok: Page_1;
    }) query;
  approvePair: (requestId: nat, minimums: opt TokenMinimums) -> (Result_34);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
