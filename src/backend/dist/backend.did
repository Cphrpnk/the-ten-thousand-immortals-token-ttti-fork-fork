                    };
   belowMinimum: record {
                   minimumTtti: nat;
                   requestedTtti: nat;
                 };
   deliveryFailedRefundFailed;
   deliveryFailedRefunded;
   insufficientBalance: record {
                          balance: nat;
                          token: PayToken;
                        };
   invalidAmount;
   ledgerError: record {token: PayToken;};
   ledgerMismatch:
    record {
      actualDecimals: nat8;
      actualFee: nat;
      expectedDecimals: nat8;
      expectedFee: nat;
      token: PayToken;
    };
   notConfigured;
   priceUnavailable: record {token: PayToken;};
   purchaseInProgress;
